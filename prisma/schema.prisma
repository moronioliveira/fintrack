generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Identidade ────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  // Mantidos por compatibilidade com a primeira versão do app.
  currency     String       @default("BRL")
  theme        String       @default("dark")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  data         UserData?
  memberships  Membership[]
  transactions Transaction[] @relation("TransactionCreatedBy")
}

/// Armazenamento legado (JSON). Importado automaticamente para o modelo
/// relacional no primeiro acesso após a atualização.
model UserData {
  id         String    @id @default(cuid())
  userId     String    @unique
  payload    String
  importedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Espaços de trabalho (pessoal ou empresa) ──────────────────────────────────

enum WorkspaceType {
  PERSONAL
  BUSINESS
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id             String          @id @default(cuid())
  name           String
  type           WorkspaceType   @default(PERSONAL)
  document       String?
  currency       String          @default("BRL")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    Membership[]
  accounts       Account[]
  categories     Category[]
  contacts       Contact[]
  costCenters    CostCenter[]
  transactions   Transaction[]
  recurringRules RecurringRule[]
  budgets        Budget[]
  goals          Goal[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ─── Cadastros ─────────────────────────────────────────────────────────────────

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  INVESTMENT
  OTHER
}

model Account {
  id                   String          @id @default(cuid())
  workspaceId          String
  name                 String
  type                 AccountType     @default(CHECKING)
  initialBalance       Decimal         @default(0) @db.Decimal(14, 2)
  creditLimit          Decimal?        @db.Decimal(14, 2)
  color                String          @default("#6366f1")
  archived             Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions         Transaction[]   @relation("TransactionAccount")
  incomingTransfers    Transaction[]   @relation("TransactionTransferAccount")
  recurringRules       RecurringRule[]

  @@index([workspaceId])
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model Category {
  id             String          @id @default(cuid())
  workspaceId    String
  name           String
  kind           CategoryKind
  color          String          @default("#64748b")
  icon           String          @default("Tag")
  archived       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  budgets        Budget[]

  @@unique([workspaceId, kind, name])
  @@index([workspaceId])
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Contact {
  id             String          @id @default(cuid())
  workspaceId    String
  name           String
  type           ContactType     @default(BOTH)
  document       String?
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime        @default(now())
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]

  @@index([workspaceId])
}

model CostCenter {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([workspaceId, name])
}

// ─── Lançamentos ───────────────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PAID
  PENDING
}

model Transaction {
  id                String            @id @default(cuid())
  workspaceId       String
  type              TransactionType
  status            TransactionStatus @default(PAID)
  description       String
  amount            Decimal           @db.Decimal(14, 2)
  /// Data de competência / vencimento.
  date              DateTime          @db.Date
  paidAt            DateTime?         @db.Date
  notes             String?
  accountId         String
  transferAccountId String?
  categoryId        String?
  contactId         String?
  costCenterId      String?
  recurringRuleId   String?
  installmentGroup  String?
  installmentNumber Int?
  installmentTotal  Int?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account           Account           @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount   Account?          @relation("TransactionTransferAccount", fields: [transferAccountId], references: [id], onDelete: Cascade)
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contact           Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  costCenter        CostCenter?       @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  recurringRule     RecurringRule?    @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  createdBy         User?             @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([recurringRuleId, date])
  @@index([workspaceId, date])
  @@index([workspaceId, status, date])
  @@index([installmentGroup])
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringRule {
  id              String          @id @default(cuid())
  workspaceId     String
  type            TransactionType
  description     String
  amount          Decimal         @db.Decimal(14, 2)
  frequency       Frequency       @default(MONTHLY)
  startDate       DateTime        @db.Date
  endDate         DateTime?       @db.Date
  /// Última data para a qual um lançamento já foi gerado.
  generatedUntil  DateTime?       @db.Date
  active          Boolean         @default(true)
  accountId       String
  categoryId      String?
  contactId       String?
  createdAt       DateTime        @default(now())
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account         Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contact         Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  transactions    Transaction[]

  @@index([workspaceId])
}

// ─── Planejamento ──────────────────────────────────────────────────────────────

model Budget {
  id          String    @id @default(cuid())
  workspaceId String
  categoryId  String
  amount      Decimal   @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, categoryId])
}

model Goal {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  targetAmount  Decimal   @db.Decimal(14, 2)
  currentAmount Decimal   @default(0) @db.Decimal(14, 2)
  deadline      DateTime? @db.Date
  color         String    @default("#10b981")
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
